// contract._calc_reward(staked: uint64, apr: uint64, duration: uint64) -> uint64:
_calc_reward:
    // contract.py:319-320
    // @subroutine
    // def _calc_reward(staked: UInt64, apr: UInt64, duration: UInt64) -> UInt64:
    proto 3 1
    // contract.py:338
    // if not apr or not duration:
    frame_dig -2
    bz _calc_reward_if_body@2
    frame_dig -1
    bnz _calc_reward_after_if_else@3

_calc_reward_if_body@2:
    // contract.py:339
    // return UInt64(0)
    intc_0 // 0
    retsub

_calc_reward_after_if_else@3:
    // contract.py:341
    // h, l = op.mulw(staked, duration)
    frame_dig -3
    frame_dig -1
    mulw
    // contract.py:342
    // h2, l2 = op.mulw(l, apr)
    frame_dig -2
    mulw
    // contract.py:343
    // h_final = h * apr + h2
    uncover 2
    frame_dig -2
    *
    uncover 2
    +
    // contract.py:345
    // qh, ql, _rh, _rl = op.divmodw(h_final, l2, UInt64(0), divisor)
    swap
    intc_0 // 0
    // contract.py:344
    // divisor = UInt64(10000) * UInt64(SECONDS_PER_YEAR)
    pushint 311040000000
    // contract.py:345
    // qh, ql, _rh, _rl = op.divmodw(h_final, l2, UInt64(0), divisor)
    divmodw
    popn 2
    swap
    // contract.py:346
    // assert not qh, "Reward overflow"
    !
    assert // Reward overflow
    // contract.py:347
    // return ql
    retsub


