_calc_reward:
    // fry_arc200_staking/contract.py:366-367
    // @subroutine
    // def _calc_reward(staked: UInt64, apr: UInt64, duration: UInt64) -> UInt64:
    proto 3 1
    // fry_arc200_staking/contract.py:378
    // if not apr or not duration:
    frame_dig -2
    bz _calc_reward_if_body@2
    frame_dig -1
    bnz _calc_reward_after_if_else@3

_calc_reward_if_body@2:
    // fry_arc200_staking/contract.py:379
    // return UInt64(0)
    intc_0 // 0
    retsub

_calc_reward_after_if_else@3:
    // fry_arc200_staking/contract.py:381
    // h, l = op.mulw(staked, duration)
    frame_dig -3
    frame_dig -1
    mulw
    // fry_arc200_staking/contract.py:382
    // h2, l2 = op.mulw(l, apr)
    frame_dig -2
    mulw
    // fry_arc200_staking/contract.py:383
    // h_final = h * apr + h2
    uncover 2
    frame_dig -2
    *
    uncover 2
    +
    // fry_arc200_staking/contract.py:385
    // qh, ql, _rh, _rl = op.divmodw(h_final, l2, UInt64(0), divisor)
    swap
    intc_0 // 0
    // fry_arc200_staking/contract.py:384
    // divisor = UInt64(10000) * UInt64(SECONDS_PER_YEAR)
    pushint 311040000000
    // fry_arc200_staking/contract.py:385
    // qh, ql, _rh, _rl = op.divmodw(h_final, l2, UInt64(0), divisor)
    divmodw
    popn 2
    swap
    // fry_arc200_staking/contract.py:386
    // assert not qh, "Reward overflow"
    !
    assert // Reward overflow
    // fry_arc200_staking/contract.py:387
    // return ql
    retsub


