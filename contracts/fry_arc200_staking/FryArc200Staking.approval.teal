// fry_arc200_staking.contract._arc200_transfer(token_app: uint64, receiver: bytes, amount: uint64) -> void:
_arc200_transfer:
    // fry_arc200_staking/contract.py:347-348
    // @subroutine
    // def _arc200_transfer(token_app: UInt64, receiver: Account, amount: UInt64) -> None:
    proto 3 0
    // fry_arc200_staking/contract.py:353-356
    // # Build ABI-encoded args: address (32 bytes) + uint256 (32 bytes, big-endian)
    // # Address is the raw 32-byte public key
    // # uint256: pad UInt64 to 32 bytes (24 zero bytes + 8-byte big-endian)
    // amount_bytes = Bytes(b"\x00" * 24) + op.itob(amount)
    frame_dig -1
    itob
    pushbytes 0x000000000000000000000000000000000000000000000000
    swap
    concat
    // fry_arc200_staking/contract.py:357
    // args = receiver.bytes + amount_bytes
    frame_dig -2
    swap
    concat
    // fry_arc200_staking/contract.py:359-363
    // itxn.ApplicationCall(
    //     app_id=Application(token_app),
    //     app_args=(ARC200_TRANSFER_SEL, args),
    //     fee=0,
    // ).submit()
    itxn_begin
    // fry_arc200_staking/contract.py:361
    // app_args=(ARC200_TRANSFER_SEL, args),
    bytec 8 // 0xda7025b9
    itxn_field ApplicationArgs
    itxn_field ApplicationArgs
    frame_dig -3
    itxn_field ApplicationID
    // fry_arc200_staking/contract.py:359
    // itxn.ApplicationCall(
    pushint 6 // appl
    itxn_field TypeEnum
    // fry_arc200_staking/contract.py:362
    // fee=0,
    intc_0 // 0
    itxn_field Fee
    // fry_arc200_staking/contract.py:359-363
    // itxn.ApplicationCall(
    //     app_id=Application(token_app),
    //     app_args=(ARC200_TRANSFER_SEL, args),
    //     fee=0,
    // ).submit()
    itxn_submit
    retsub


